<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>ValorEngine.Core</RootNamespace>
    <AssemblyName>ValorEngine.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MonoGame DesktopGL: pure C# engine framework. Owns the window (SDL2),
         the OpenGL context, input, audio and the GPU draw pipeline. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.11091" />
  </ItemGroup>

</Project>
